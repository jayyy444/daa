-- Function
DELIMITER //
CREATE FUNCTION calcTax(sal DECIMAL(10,2))
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    DECLARE tax DECIMAL(10,2);
    IF sal > 60000 THEN
        SET tax = sal * 0.20;
    ELSE
        SET tax = sal * 0.10;
    END IF;
    RETURN tax;
END //
DELIMITER ;

-- Procedure using function
DELIMITER //
CREATE PROCEDURE empTaxReport()
BEGIN
    SELECT emp_id, emp_name, salary, calcTax(salary) AS tax FROM employee;
END //
DELIMITER ;

-- Salary log table
CREATE TABLE salary_log(
    log_id INT AUTO_INCREMENT PRIMARY KEY,
    emp_id INT,
    old_sal DECIMAL(10,2),
    new_sal DECIMAL(10,2),
    change_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Trigger
DELIMITER //
CREATE TRIGGER salary_change
AFTER UPDATE ON employee
FOR EACH ROW
BEGIN
    IF OLD.salary <> NEW.salary THEN
        INSERT INTO salary_log(emp_id, old_sal, new_sal) 
        VALUES(NEW.emp_id, OLD.salary, NEW.salary);
    END IF;
END //
DELIMITER ;


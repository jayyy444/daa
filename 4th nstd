-- Employees with salary greater than average salary
SELECT * FROM employee WHERE salary > (SELECT AVG(salary) FROM employee);

-- Employees working in IT department
SELECT emp_name FROM employee WHERE dept_id = (SELECT dept_id FROM department WHERE dept_name='IT');

-- Employees in departments located in Mumbai or Delhi
SELECT * FROM employee WHERE dept_id IN (SELECT dept_id FROM department WHERE location IN ('Mumbai','Delhi'));

-- Employee with maximum salary
SELECT emp_name, salary FROM employee WHERE salary = (SELECT MAX(salary) FROM employee);

-- Departments having employees
SELECT dept_name FROM department WHERE dept_id IN (SELECT dept_id FROM employee);

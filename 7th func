-- String functions
SELECT UPPER(emp_name), LOWER(emp_name), LENGTH(emp_name) FROM employee;
SELECT CONCAT(emp_name,' works in dept ',dept_id) AS info FROM employee;
SELECT SUBSTRING(emp_name,1,3) FROM employee;

-- Numeric functions
SELECT emp_name, ROUND(salary,2), CEIL(salary), FLOOR(salary) FROM employee;

-- Date functions
SELECT NOW(), CURDATE(), CURTIME();
SELECT YEAR(NOW()), MONTH(NOW()), DAY(NOW());

-- User Defined Function
DELIMITER //
CREATE FUNCTION getBonus(sal DECIMAL(10,2)) 
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    DECLARE bonus DECIMAL(10,2);
    SET bonus = sal * 0.10;
    RETURN bonus;
END //
DELIMITER ;

SELECT emp_name, salary, getBonus(salary) AS bonus FROM employee;
